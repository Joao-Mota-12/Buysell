{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=BuysellDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:4200;",
    "ExposedHeaders": "",
    "AccessControlAllowCredentials": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "keycloak": {
    "AuthorizationUrl": "http://localhost:8080/realms/buysell-realm/protocol/openid-connect/auth"
  },
  "Authentication": {
    "MetadataAddress": "http://keycloak:8080/realms/buysell-realm/.well-known/openid-configuration",
    "ValidIssuer": "http://localhost:8080/realms/buysell-realm",
    "Audiente": "account"
  },
  "AllowedHosts": "*"
}
